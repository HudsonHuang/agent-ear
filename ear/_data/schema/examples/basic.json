  "speech": {
    "segments": [
      {
        "start_ms": 0,
        "end_ms": 1000,
        "speaker": "S1",
        "text": "自己紹介か",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0001"
      },
      {
        "start_ms": 1500,
        "end_ms": 2500,
        "speaker": "S2",
        "text": "自己紹介",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0002"
      },
      {
        "start_ms": 3000,
        "end_ms": 4500,
        "speaker": "S1",
        "text": "若町アロルです。はい。",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0003"
      },
      {
        "start_ms": 5000,
        "end_ms": 6500,
        "speaker": "S2",
        "text": "はい、戦国ゆのです。",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0004"
      },
      {
        "start_ms": 7000,
        "end_ms": 8500,
        "speaker": "S1",
        "text": "真似しないでよ！",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0005"
      },
      {
        "start_ms": 11000,
        "end_ms": 12500,
        "speaker": "S2",
        "text": "今最後ちょっと真似してたでしょ。",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0006"
      },
      {
        "start_ms": 13000,
        "end_ms": 14000,
        "speaker": "S1",
        "text": "ですって。",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0007"
      },
      {
        "start_ms": 14500,
        "end_ms": 15500,
        "speaker": "S2",
        "text": "です。",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0008"
      },
      {
        "start_ms": 18500,
        "end_ms": 21500,
        "speaker": "S1",
        "text": "今日は、あの、似てるだって。今の。似てた？",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0009"
      },
      {
        "start_ms": 23500,
        "end_ms": 27000,
        "speaker": "S2",
        "text": "いや、配信のね、枠のね主にね、ちょっとな。",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0010"
      },
      {
        "start_ms": 28000,
        "end_ms": 29000,
        "speaker": "S1",
        "text": "あ、言ってくれたの？",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0011"
      },
      {
        "start_ms": 29000,
        "end_ms": 32500,
        "speaker": "S2",
        "text": "そうそう。そっちにね。出した方がいいかなって。",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0012"
      },
      {
        "start_ms": 33500,
        "end_ms": 34500,
        "speaker": "S1",
        "text": "気遣いだったんだ。",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0013"
      },
      {
        "start_ms": 35000,
        "end_ms": 38000,
        "speaker": "S1",
        "text": "え、僕はどうだった？この前の真似。いたでしょ。",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0014"
      },
      {
        "start_ms": 38000,
        "end_ms": 40000,
        "speaker": "S2",
        "text": "あ、似てない似てない。二度とやらないで。",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0015"
      },
      {
        "start_ms": 40000,
        "end_ms": 42500,
        "speaker": "S1",
        "text": "え、なんで？なんで？",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0016"
      },
      {
        "start_ms": 43000,
        "end_ms": 48500,
        "speaker": "S2",
        "text": "いやなんか聞いててさ、突然声低くなったなって思ったの。そしたら私の真似だった。",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0017"
      },
      {
        "start_ms": 48500,
        "end_ms": 49500,
        "speaker": "S1",
        "text": "嘘だよ。",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0018"
      },
      {
        "start_ms": 51000,
        "end_ms": 53000,
        "speaker": "S2",
        "text": "マジかと思って笑い転げたよね。",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0019"
      },
      {
        "start_ms": 53500,
        "end_ms": 54500,
        "speaker": "S1",
        "text": "あ、笑い転げた？",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0020"
      },
      {
        "start_ms": 54500,
        "end_ms": 55000,
        "speaker": "S2",
        "text": "うん。",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0021"
      },
      {
        "start_ms": 55000,
        "end_ms": 57500,
        "speaker": "S1",
        "text": "あ、ならよかった。全然似てないって言ってたから。",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0022"
      },
      {
        "start_ms": 58000,
        "end_ms": 59000,
        "speaker": "S2",
        "text": "似てないよ。",
        "lang": "",
        "conf": null,
        "words": [],
        "source": "omni",
        "id": "sp_0023"
      }
    ],
