{
  "name": "agent-ear",
  "version": "0.2.10",
  "description": "DeepSeek Harness / Claude skill for timestamped audio: install with npx -y agent-ear@latest setup. Speech, sound events, music/BPM, SRT/EDL export, mixcheck.",
  "type": "module",
  "main": "dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "LICENSE",
    "install.ps1",
    "install.sh"
  ],
  "scripts": {
    "test": "node dsh/selfcheck.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "audio",
    "video",
    "timestamps",
    "beat",
    "transcription"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-skill": "^0.0.1-rc.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HudsonHuang/agent-ear.git"
  },
  "homepage": "https://github.com/HudsonHuang/agent-ear",
  "bin": {
    "agent-ear": "dsh/cli.js"
  }
}
